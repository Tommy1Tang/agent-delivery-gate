{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.qoder/skills/software-development-team/bootstrap-baseline-statement.schema.json",
  "title": "BaselineStatement",
  "type": "object",
  "required": ["schemaVersion", "statementId", "statementType", "repositoryId", "deliveryId", "startingProcessVersion", "activatedVersion", "absenceReason", "afterManifestHash", "afterTraceHash", "inventoryHash", "gateEvidenceHashes", "comparisonMode", "diffClaimed", "declaration", "createdAt", "hashExcludedFields", "contentHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "statementId": {"pattern": "^CBS-[0-9a-f]{24}$"},
    "statementType": {"const": "bootstrap-baseline-created"},
    "repositoryId": {"type": "string", "minLength": 1, "maxLength": 128},
    "deliveryId": {"type": "string", "minLength": 1, "maxLength": 128},
    "startingProcessVersion": {"const": "1.0.0"},
    "activatedVersion": {"const": "1.1.0"},
    "absenceReason": {"const": "code-intelligence-before-baseline-not-available-prior-to-activation"},
    "afterManifestHash": {"$ref": "#/$defs/hash"},
    "afterTraceHash": {"$ref": "#/$defs/hash"},
    "inventoryHash": {"$ref": "#/$defs/hash"},
    "gateEvidenceHashes": {"type": "array", "items": {"$ref": "#/$defs/hash"}, "uniqueItems": true},
    "comparisonMode": {"const": "baseline-creation"},
    "diffClaimed": {"const": false},
    "declaration": {"const": "This evidence creates the first after baseline and does not claim a pre-change snapshot or before/after diff."},
    "createdAt": {"$ref": "#/$defs/timestamp"},
    "hashExcludedFields": {"const": ["createdAt", "contentHash", "inventoryHash", "statementId"]},
    "contentHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  },
  "additionalProperties": false
}
