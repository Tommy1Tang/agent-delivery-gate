{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.qoder/skills/software-development-team/bootstrap-activation.schema.json",
  "title": "ActivationRecord",
  "type": "object",
  "required": ["schemaVersion", "activationRecordId", "tokenId", "repositoryId", "deliveryId", "startingProcessVersion", "activatedVersion", "activatedAt", "bootstrapReason", "inventoryHash", "afterManifestHash", "afterTraceHash", "baselineStatementHash", "consumed", "hashExcludedFields", "recordHash"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "activationRecordId": {"pattern": "^CAR-[0-9a-f]{24}$"},
    "tokenId": {"$ref": "#/$defs/hash"},
    "repositoryId": {"type": "string", "minLength": 1, "maxLength": 128},
    "deliveryId": {"type": "string", "minLength": 1, "maxLength": 128},
    "startingProcessVersion": {"const": "1.0.0"},
    "activatedVersion": {"const": "1.1.0"},
    "activatedAt": {"$ref": "#/$defs/timestamp"},
    "bootstrapReason": {"const": "initial-code-intelligence-baseline"},
    "inventoryHash": {"$ref": "#/$defs/hash"},
    "afterManifestHash": {"$ref": "#/$defs/hash"},
    "afterTraceHash": {"$ref": "#/$defs/hash"},
    "baselineStatementHash": {"$ref": "#/$defs/hash"},
    "consumed": {"const": true},
    "hashExcludedFields": {"const": ["recordHash", "activationRecordId"]},
    "recordHash": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"}
  },
  "additionalProperties": false
}
